{
    admin off
    # Reverse-proxy errors use this logger, not only the site's access log.
    log default {
        format filter {
            wrap json
            fields {
                request>uri replace [redacted]
                request>headers delete
                resp_headers delete
            }
        }
    }
}

(private-access-log) {
    log {
        output stdout
        format filter {
            wrap json
            fields {
                request>uri replace [redacted]
                request>headers delete
                resp_headers delete
            }
        }
    }
}

{$SITE_DOMAIN} {
    import private-access-log
    encode zstd gzip

    header {
        -Server
        X-Content-Type-Options "nosniff"
        X-Frame-Options "DENY"
        Referrer-Policy "strict-origin-when-cross-origin"
    }

    handle_path /media/* {
        root * /srv/media
        file_server
    }

    handle {
        reverse_proxy kidstime-web:8000
    }
}

import /etc/caddy/extra/*.caddy
