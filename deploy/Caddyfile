{
    admin off
}

{$SITE_DOMAIN} {
    encode zstd gzip

    header {
        -Server
        X-Content-Type-Options "nosniff"
        X-Frame-Options "DENY"
        Referrer-Policy "strict-origin-when-cross-origin"
    }

    handle_path /media/* {
        root * /srv/media
        file_server
    }

    handle {
        reverse_proxy kidstime-web:8000
    }

    log {
        output stdout
        format console
    }
}

import /etc/caddy/extra/*.caddy
