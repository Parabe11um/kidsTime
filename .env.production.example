SITE_DOMAIN=kidstime.devtestenv.ru
# Set the exact image from a verified release and load it before starting Caddy.
CADDY_IMAGE=

DJANGO_DEBUG=false
DJANGO_SECRET_KEY=replace-with-a-long-random-value
DJANGO_ALLOWED_HOSTS=kidstime.devtestenv.ru,localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=https://kidstime.devtestenv.ru
DJANGO_SECURE_SSL_REDIRECT=true
DJANGO_SESSION_COOKIE_SECURE=true
DJANGO_CSRF_COOKIE_SECURE=true
DJANGO_SECURE_HSTS_SECONDS=3600
DJANGO_SECURE_HSTS_INCLUDE_SUBDOMAINS=false
ROBOTS_NOINDEX=true

POSTGRES_DB=kidstime
POSTGRES_USER=kidstime
POSTGRES_PASSWORD=replace-with-a-random-hex-value
DATABASE_URL=postgis://kidstime:replace-with-the-same-random-hex-value@db:5432/kidstime
REDIS_URL=redis://redis:6379/0

YANDEX_MAPS_API_KEY=
LOAD_DEMO_DATA=true
RUN_MIGRATIONS=true

# Registration requires the URL of the published privacy policy.
PRIVACY_POLICY_URL=
# Explicit opt-in for test registration using the local privacy draft.
TEST_REGISTRATION_ENABLED=false
# True only behind our Caddy proxy; web has no public port in production.
AUTH_TRUST_PROXY_IP=true

# Password reset email. Use TLS on 587 OR SSL on 465.
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=true
EMAIL_USE_SSL=false
DEFAULT_FROM_EMAIL=
